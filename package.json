{
  "name": "mcp-context-cost",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "ingest:discover": "tsx scripts/ingest-discover.ts",
    "ingest:capture": "tsx scripts/ingest-capture.ts",
    "build:index": "tsx scripts/build-search-index.ts",
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace packages/analyzer && npm run build --workspace apps/web"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
